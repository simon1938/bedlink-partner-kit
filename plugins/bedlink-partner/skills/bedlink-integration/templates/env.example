# ── BedLink (server only: never NEXT_PUBLIC_, never committed) ──────────
# Partner API key, created in your BedLink partner space (https://app.bedlink.fr/fr/partenaire).
BEDLINK_API_KEY=
# Webhook signing secret given by BedLink (whsec_…). Two during a rotation: "new,old".
# Until BedLink sends webhooks, a local secret generated by the skill is enough.
BEDLINK_WEBHOOK_SECRET=
# Optional. Default: https://app.bedlink.fr/api/partner/v1
# BEDLINK_API_URL=
# Features opened by BedLink, comma-separated (empty = today's sandbox):
# calendar_366,changes,webhooks,reservations_list,messages,payments
BEDLINK_FEATURES=
# Prefix of your externalId values (reservation references).
BEDLINK_EXTERNAL_ID_PREFIX=
# Vercel sends it to the cron as "Authorization: Bearer …". Random, 32+ characters.
CRON_SECRET=

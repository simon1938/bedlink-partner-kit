{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/lib/prisma": ["./test/stubs/prisma.ts"],
      "@/*": ["./plugins/bedlink-partner/skills/bedlink-integration/templates/*"]
    }
  },
  "include": ["plugins/**/templates/**/*.ts", "plugins/**/templates/**/*.tsx", "test/**/*.ts"]
}
